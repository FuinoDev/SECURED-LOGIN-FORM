NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://root:YOUR_PASSWORD@localhost:5432/secured_login"

# Minimum 32 characters — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

CLIENT_URL="http://localhost:5173"

SESSION_MAX_AGE_DAYS=7
VERIFICATION_TOKEN_HOURS=24
RESET_TOKEN_HOURS=1
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="SecureAdminPass123!"
